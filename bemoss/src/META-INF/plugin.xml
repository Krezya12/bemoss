<idea-plugin>
  <id>com.bemoss.core</id>
  <name>BeMoss Core Base</name>
  <vendor>BeMoss Team</vendor>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Наш глобальный фильтр левой панели -->
    <newProjectWizard.stepProviderFilter implementation="com.bemoss.ide.wizard.BeMossNewProjectWizardFilter"/>

    <!-- Наши три шаблона проектов Minecraft Bedrock -->
    <directoryProjectGenerator implementation="com.bemoss.ide.wizard.BedrockAddonGenerator"/>
    <directoryProjectGenerator implementation="com.bemoss.ide.wizard.MinecraftBehaviourPackGenerator"/>
    <directoryProjectGenerator implementation="com.bemoss.ide.wizard.MinecraftResourcePackGenerator"/>
  </extensions>
</idea-plugin>
